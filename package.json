{
  "name": "whale-options",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gen:fixtures": "tsx scripts/generate-fixtures.ts",
    "bench": "pnpm --filter @luxalgo/whale-cli exec whale bench",
    "canary:thetadata": "tsx scripts/canaries/thetadata.ts",
    "canary:massive": "tsx scripts/canaries/massive.ts",
    "canary:alpaca": "tsx scripts/canaries/alpaca.ts",
    "canary:tradier": "tsx scripts/canaries/tradier.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
